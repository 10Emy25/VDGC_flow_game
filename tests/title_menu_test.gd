extends Node
func _ready() -> void:
	var main: Control = load("res://scenes/main.tscn").instantiate()
	add_child(main)
	assert(main.current_view is TitleMenu, "Menu is the first screen")
	main._process(0)
	assert(not main.settings_button.visible and not main.mic_warning.visible)
	var menu: TitleMenu = main.current_view
	assert(menu.menu_music.stream != null)
	assert(absf(menu.menu_music.stream.get_length() - 31.764) < 0.06)
	assert(menu.menu_music.process_mode == Node.PROCESS_MODE_ALWAYS)
	var factor := menu.size / menu.ART_SIZE
	assert(menu.new_button.get_rect().has_point(menu.NEW_REGION.get_center() * factor))
	assert(menu.settings_button.get_rect().has_point(menu.SETTINGS_REGION.get_center() * factor))
	assert(not menu.new_button.get_rect().intersects(menu.settings_button.get_rect()))
	for overlay in menu.hover_art:
		assert(not overlay.visible, "No hover highlight on initial keyboard focus")
	menu.new_button.mouse_entered.emit()
	assert(menu.hover_art[0].visible and not menu.hover_art[1].visible)
	menu.settings_button.mouse_entered.emit()
	menu.new_button.mouse_exited.emit()
	assert(not menu.hover_art[0].visible and menu.hover_art[1].visible)
	menu.settings_button.mouse_exited.emit()
	assert(not menu.hover_art[1].visible)
	menu.quit_button.mouse_entered.emit()
	assert(menu.hover_art[2].visible)
	menu.quit_button.mouse_exited.emit()
	menu.sound_button.mouse_entered.emit()
	assert(menu.hover_art[3].visible)
	menu.sound_button.mouse_exited.emit()
	menu.size = Vector2(1180, 820)
	menu.layout_hotspots()
	assert(menu.hover_art[0].get_rect() == menu.new_button.get_rect())
	assert(menu.normal_new.get_rect() == menu.new_button.get_rect())
	assert(menu.hover_art[1].get_rect() == menu.settings_button.get_rect())
	var previous_reduce: bool = GameState.settings.get("reduce_scares", false)
	GameState.settings["reduce_scares"] = false
	assert(menu.scare_wait >= 6.0 and menu.scare_wait <= 12.0)
	assert(not menu.scare_active and not menu.scare_art.visible)
	assert(menu.scare_art.mouse_filter == Control.MOUSE_FILTER_IGNORE)
	assert(absf(menu.static_audio.stream.get_length() - 1.3) < 0.01)
	assert(absf(menu.laugh_audio.stream.get_length() - 1.3) < 0.01)
	assert(menu.static_audio.volume_db == -8 and menu.laugh_audio.volume_db == -7)
	menu.menu_music.play(3.0)
	var saved_cursor := menu.menu_music.get_playback_position()
	menu.scare_wait = 0.01
	menu._process(0.02)
	assert(menu.scare_active and menu.scare_art.visible)
	assert(menu.menu_music.stream_paused)
	assert(absf(menu.menu_music.get_playback_position() - saved_cursor) < 0.05)
	assert(menu.scare_duration >= 1.1 and menu.scare_duration <= 1.3)
	menu._process(0.08)
	assert(not menu.scare_art.visible)
	menu._process(0.05)
	assert(menu.scare_art.visible)
	menu._process(1.4)
	assert(not menu.scare_active and not menu.scare_art.visible)
	assert(menu.scare_wait >= 9.0 and menu.scare_wait <= 19.0)
	assert(not menu.menu_music.stream_paused)
	assert(menu.menu_music.playing and menu.menu_music.get_playback_position() >= saved_cursor)
	menu.start_scare()
	GameState.settings["reduce_scares"] = true
	menu._process(0.01)
	assert(not menu.scare_active and not menu.scare_art.visible)
	menu.start_scare()
	assert(not menu.scare_active)
	GameState.settings["reduce_scares"] = false
	menu.start_scare()
	menu.settings_button.mouse_entered.emit()
	menu.settings_button.pressed.emit()
	assert(not menu.scare_active and not menu.scare_art.visible)
	assert(not menu.hover_art[1].visible, "Opening settings clears hover")
	assert(main.settings_panel.visible and get_tree().paused)
	assert(main.current_view == menu)
	main.settings_panel.close()
	main._process(0)
	assert(not get_tree().paused and main.current_view == menu)
	assert(not main.settings_button.visible)
	assert(menu.sound_icon.texture == menu.sound_textures[0])
	assert(menu.sound_icon.get_rect() == menu.sound_button.get_rect())
	menu.sound_button.pressed.emit()
	assert(menu.sound_icon.texture == menu.sound_textures[1])
	assert(menu.hover_art[3].texture == menu.sound_icon.texture)
	assert(menu.muted and menu.menu_music.volume_db == -80)
	menu.sound_button.pressed.emit()
	assert(not menu.muted and menu.menu_music.volume_db == -16)
	assert(menu.sound_icon.texture == menu.sound_textures[0])
	assert(menu.hover_art[3].texture == menu.sound_icon.texture)
	menu.start_scare()
	menu.new_button.pressed.emit()
	assert(not menu.scare_active and not menu.scare_art.visible)
	assert(not menu.static_audio.playing and not menu.laugh_audio.playing)
	GameState.settings["reduce_scares"] = previous_reduce
	assert(main.current_view is BedroomIntro, "New goes directly to Mina's opening bedroom")
	assert(not menu.menu_music.playing)
	assert(main.current_view.music_age < 0 and not main.current_view.sleeping)
	var standalone := TitleMenu.new()
	add_child(standalone)
	var quit_received := [false]
	standalone.quit_requested.connect(func() -> void: quit_received[0] = true)
	standalone.quit_button.pressed.emit()
	assert(quit_received[0])
	print("Title menu passed: randomized scare timing, flicker/recovery, pause/start cleanup, reduced-scare preference, startup art, mapped New/Setting buttons, pause/return, looping menu track, mute, quit signal and direct bedroom start")
	get_tree().quit()
