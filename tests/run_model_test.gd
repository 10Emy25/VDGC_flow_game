extends MinaTestSuite

func _ready() -> void:
	var b := GameState.balance
	var run := RunModel.new(b)
	for index in range(15):
		run.step(0.01, 7, false)
	near(run.speed, 3.5, "Acceleration linear halfway")
	for index in range(15):
		run.step(0.01, 7, false)
	near(run.speed, 7, "Acceleration reaches target at 0.3 seconds")
	for index in range(100):
		run.step(0.01, 0, false)
	near(run.speed, 3.5, "One-second half-life")
	near(run.x - 1.05, 7 / log(2.0) * 0.5, "Coasting distance matches integral", 0.002)
	for index in range(100):
		run.step(0.01, 0, false)
	near(run.speed, 1.75, "Two-second decay")
	run = RunModel.new(b)
	for index in range(290):
		run.step(0.01, 7, true)
	check(not run.guarded, "Throat guard off before 3 seconds")
	for index in range(20):
		run.step(0.01, 7, true)
	check(run.guarded, "Throat guard on after 3 seconds")
	near(run.previous_target, 5, "Guard caps target at 5")
	run.step(0.49, 0, false)
	check(run.guarded, "Guard remains during short breath")
	run.step(0.02, 0, false)
	check(not run.guarded, "Half-second breath resets guard")
	run.step(0.3, 7, true)
	near(run.speed, 7, "Raised voice reaches cap after breath")
	run = RunModel.new(b)
	run.scripted_scare()
	run.step(1.49, 0, false)
	run.step(0.01, 7, true)
	near(run.previous_target, 9.1, "Instinct bonus inside window")
	check(run.bonus_left > 0, "Bonus has duration")
	for index in range(210):
		run.step(0.01, 7, true)
	near(run.previous_target, 7, "Instinct expires")
	run = RunModel.new(b)
	run.scripted_scare()
	run.step(1.51, 0, false)
	run.step(0.01, 7, true)
	near(run.previous_target, 7, "Outside instinct window no bonus")
	var tutorial := TutorialModel.new(b.tutorial)
	tutorial.step(2, 1)
	check(tutorial.index == 0, "Tutorial minimum four seconds")
	tutorial.step(2.01, 0)
	check(tutorial.index == 1, "Cumulative hum retained during silence")
	tutorial.step(4.01, 1)
	check(tutorial.index == 1, "Hum cannot clear talk stage")
	tutorial.step(2.01, 2)
	check(tutorial.index == 2, "Talk stage completes")
	tutorial.step(4.01, 3)
	check(tutorial.index == 3, "Shout stage completes")
	tutorial.step(6.01, 0)
	check(tutorial.complete(), "Sing-along auto clears")
	var song := SongModel.new(GameState.song)
	near(song.duration, 19.2, "Song is eight bars")
	check(song.current(0) == 0 and song.current(19.2) == 0, "Song wraps")
	check(song.syllables[song.current(1.2)].text == "row,", "Syllable boundary")
	check(song.lines[1].count(" ") == 3, "Song joins syllables but separates words")
	near(Sfx.get_stream("mus_song").get_length(), song.duration, "WAV duration matches karaoke", 0.0001)
	run = RunModel.new(b)
	run.speed = 6
	check(run.enter_gate(470) == "jumping", "Exact gate threshold auto-jumps")
	run.step(.3, 6, false)
	near(run.jump_progress, .5, "Jump arc midpoint")
	run.step(.3, 6, false)
	check(run.gate_state.is_empty() and run.x >= 472, "Jump completes in 0.6 seconds")
	run = RunModel.new(b)
	run.speed = 5.99
	check(run.enter_gate(520) == "stumbling", "Below threshold stumbles")
	run.step(1.49, 7, true)
	near(run.x, 520, "Stumble immobilizes")
	near(run.speed, 0, "Stumble speed stays zero")
	run.step(.02, 7, true)
	check(run.gate_state == "climbing", "After 1.5 seconds climbs across")
	run.step(.6, 0, false)
	check(run.gate_state.is_empty() and run.x == 522, "Climb clears gate without a gate death")
	finish()
