extends Node
func _ready() -> void:
	for value in ["OK", "..."]:
		var ending := DreamMessageEnding.new()
		add_child(ending)
		ending.set_process(false)
		ending._process(1.4)
		assert(ending.subtitle.text == "It is just a dream..")
		ending._process(4)
		assert(ending.phase == "ring" and not ending.phone.visible)
		ending._process(1.7)
		assert(ending.phase == "first_message")
		assert(ending.first_message.visible and not ending.second_message.visible)
		assert(ending.first_message.text == "Mina...I am really worried")
		ending._process(1.9)
		assert(ending.second_message.visible and ending.second_message.text == "pls call me")
		ending._process(1.2)
		ending._process(30)
		assert(ending.phase == "choice" and ending.choice == "", "Never auto-select a reply")
		if value == "OK": ending.choice_ok.pressed.emit()
		else: ending.choice_silence.pressed.emit()
		assert(ending.phase == "after_choice" and ending.choice == value)
		assert(ending.sent_reply == (value == "OK") and ending.reply_message.visible == (value == "OK"))
		ending.choose("OK" if value == "..." else "...")
		assert(ending.choice == value, "Only one choice is accepted")
		ending._process(1.1)
		assert(ending.phase == "flower" and ending.sticker.visible)
		assert(ending.sticker.morph == 0 and ending.sticker.scale.x < 1)
		ending._process(3.1)
		assert(ending.phase == "zoom")
		ending._process(5)
		assert(ending.sticker.scale.x > 3 and ending.sticker.morph > 0 and ending.sticker.morph < 1)
		ending._process(5.1)
		assert(ending.phase == "ghost" and ending.sticker.morph == 1)
		ending._process(2.4)
		assert(ending.phase == "black")
		ending._process(2.5)
		assert(ending.phase == "done" and ending.replay.visible)
		var completed := [false]
		ending.finished.connect(func() -> void: completed[0] = true)
		ending.replay.pressed.emit()
		assert(completed[0])
		ending.queue_free()
		await get_tree().process_frame
	print("V7 ending: wake line, ordered messages, manual OK/silence branches, flower delay, slow zoom/morph, horror ending and replay passed")
	get_tree().quit()
